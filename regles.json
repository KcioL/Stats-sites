{
  "rules": {
    ".read": false,
    ".write": false,
    "stats": {
      ".read": true,
      "$site": {
        "jours": {
          "$jour": {
            "vues": {
              ".write": "$site.matches(/^[a-z0-9-]{2,30}$/) && $jour.matches(/^20[0-9]{2}-[0-9]{2}-[0-9]{2}$/)",
              ".validate": "newData.isNumber() && newData.val() == (data.exists() ? data.val() : 0) + 1"
            },
            "visiteurs": {
              ".write": "$site.matches(/^[a-z0-9-]{2,30}$/) && $jour.matches(/^20[0-9]{2}-[0-9]{2}-[0-9]{2}$/)",
              ".validate": "newData.isNumber() && newData.val() == (data.exists() ? data.val() : 0) + 1"
            },
            "nouveaux": {
              ".write": "$site.matches(/^[a-z0-9-]{2,30}$/) && $jour.matches(/^20[0-9]{2}-[0-9]{2}-[0-9]{2}$/)",
              ".validate": "newData.isNumber() && newData.val() == (data.exists() ? data.val() : 0) + 1"
            },
            "appli": {
              ".write": "$site.matches(/^[a-z0-9-]{2,30}$/) && $jour.matches(/^20[0-9]{2}-[0-9]{2}-[0-9]{2}$/)",
              ".validate": "newData.isNumber() && newData.val() == (data.exists() ? data.val() : 0) + 1"
            },
            "visites": {
              ".write": "$site.matches(/^[a-z0-9-]{2,30}$/) && $jour.matches(/^20[0-9]{2}-[0-9]{2}-[0-9]{2}$/)",
              ".validate": "newData.isNumber() && newData.val() == (data.exists() ? data.val() : 0) + 1"
            },
            "revenus": {
              ".write": "$site.matches(/^[a-z0-9-]{2,30}$/) && $jour.matches(/^20[0-9]{2}-[0-9]{2}-[0-9]{2}$/)",
              ".validate": "newData.isNumber() && newData.val() == (data.exists() ? data.val() : 0) + 1"
            },
            "prives": {
              ".write": "$site.matches(/^[a-z0-9-]{2,30}$/) && $jour.matches(/^20[0-9]{2}-[0-9]{2}-[0-9]{2}$/)",
              ".validate": "newData.isNumber() && newData.val() == (data.exists() ? data.val() : 0) + 1"
            },
            "appareils": {
              "$type": {
                ".write": "$site.matches(/^[a-z0-9-]{2,30}$/) && $jour.matches(/^20[0-9]{2}-[0-9]{2}-[0-9]{2}$/) && ($type == 'mobile' || $type == 'ordi')",
                ".validate": "newData.isNumber() && newData.val() == (data.exists() ? data.val() : 0) + 1"
              }
            },
            "pages": {
              "$page": {
                ".write": "$site.matches(/^[a-z0-9-]{2,30}$/) && $jour.matches(/^20[0-9]{2}-[0-9]{2}-[0-9]{2}$/) && $page.matches(/^[a-z0-9-]{2,40}$/)",
                ".validate": "newData.isNumber() && newData.val() == (data.exists() ? data.val() : 0) + 1"
              }
            },
            "actions": {
              "$action": {
                "$page": {
                  ".write": "$site.matches(/^[a-z0-9-]{2,30}$/) && $jour.matches(/^20[0-9]{2}-[0-9]{2}-[0-9]{2}$/) && $action.matches(/^[a-z0-9-]{2,40}$/) && $page.matches(/^[a-z0-9-]{2,40}$/)",
                  ".validate": "newData.isNumber() && newData.val() == (data.exists() ? data.val() : 0) + 1"
                }
              }
            },
            "heures": {
              "$h": {
                ".write": "$site.matches(/^[a-z0-9-]{2,30}$/) && $jour.matches(/^20[0-9]{2}-[0-9]{2}-[0-9]{2}$/) && $h.matches(/^([0-9]|1[0-9]|2[0-3])$/)",
                ".validate": "newData.isNumber() && newData.val() == (data.exists() ? data.val() : 0) + 1"
              }
            },
            "sources": {
              "$source": {
                ".write": "$site.matches(/^[a-z0-9-]{2,30}$/) && $jour.matches(/^20[0-9]{2}-[0-9]{2}-[0-9]{2}$/) && $source.matches(/^[a-z0-9-]{2,40}$/)",
                ".validate": "newData.isNumber() && newData.val() == (data.exists() ? data.val() : 0) + 1"
              }
            },
            "systemes": {
              "$systeme": {
                ".write": "$site.matches(/^[a-z0-9-]{2,30}$/) && $jour.matches(/^20[0-9]{2}-[0-9]{2}-[0-9]{2}$/) && $systeme.matches(/^[a-z0-9-]{2,20}$/)",
                ".validate": "newData.isNumber() && newData.val() == (data.exists() ? data.val() : 0) + 1"
              }
            },
            "navigateurs": {
              "$nav": {
                ".write": "$site.matches(/^[a-z0-9-]{2,30}$/) && $jour.matches(/^20[0-9]{2}-[0-9]{2}-[0-9]{2}$/) && $nav.matches(/^[a-z0-9-]{2,20}$/)",
                ".validate": "newData.isNumber() && newData.val() == (data.exists() ? data.val() : 0) + 1"
              }
            },
            "retours": {
              "$delai": {
                ".write": "$site.matches(/^[a-z0-9-]{2,30}$/) && $jour.matches(/^20[0-9]{2}-[0-9]{2}-[0-9]{2}$/) && ($delai == 'veille' || $delai == 'semaine' || $delai == 'mois' || $delai == 'plus')",
                ".validate": "newData.isNumber() && newData.val() == (data.exists() ? data.val() : 0) + 1"
              }
            },
            "erreurs": {
              "$page": {
                ".write": "$site.matches(/^[a-z0-9-]{2,30}$/) && $jour.matches(/^20[0-9]{2}-[0-9]{2}-[0-9]{2}$/) && $page.matches(/^[a-z0-9-]{2,40}$/)",
                ".validate": "newData.isNumber() && newData.val() == (data.exists() ? data.val() : 0) + 1"
              }
            },
            "contenus": {
              "$type": {
                "$id": {
                  ".write": "$site.matches(/^[a-z0-9-]{2,30}$/) && $jour.matches(/^20[0-9]{2}-[0-9]{2}-[0-9]{2}$/) && $type.matches(/^[a-z0-9-]{2,20}$/) && $id.matches(/^[a-z0-9-]{2,40}$/)",
                  ".validate": "newData.isNumber() && newData.val() == (data.exists() ? data.val() : 0) + 1"
                }
              }
            },
            "temps": {
              "$page": {
                "s": {
                  ".write": "$site.matches(/^[a-z0-9-]{2,30}$/) && $jour.matches(/^20[0-9]{2}-[0-9]{2}-[0-9]{2}$/) && $page.matches(/^[a-z0-9-]{2,40}$/)",
                  ".validate": "newData.isNumber() && newData.val() > (data.exists() ? data.val() : 0) && newData.val() <= (data.exists() ? data.val() : 0) + 1800"
                },
                "n": {
                  ".write": "$site.matches(/^[a-z0-9-]{2,30}$/) && $jour.matches(/^20[0-9]{2}-[0-9]{2}-[0-9]{2}$/) && $page.matches(/^[a-z0-9-]{2,40}$/)",
                  ".validate": "newData.isNumber() && newData.val() == (data.exists() ? data.val() : 0) + 1"
                }
              }
            },
            "chargement": {
              "ms": {
                ".write": "$site.matches(/^[a-z0-9-]{2,30}$/) && $jour.matches(/^20[0-9]{2}-[0-9]{2}-[0-9]{2}$/)",
                ".validate": "newData.isNumber() && newData.val() > (data.exists() ? data.val() : 0) && newData.val() <= (data.exists() ? data.val() : 0) + 60000"
              },
              "n": {
                ".write": "$site.matches(/^[a-z0-9-]{2,30}$/) && $jour.matches(/^20[0-9]{2}-[0-9]{2}-[0-9]{2}$/)",
                ".validate": "newData.isNumber() && newData.val() == (data.exists() ? data.val() : 0) + 1"
              }
            },
            "bugs": {
              "$id": {
                ".write": "$site.matches(/^[a-z0-9-]{2,30}$/) && $jour.matches(/^20[0-9]{2}-[0-9]{2}-[0-9]{2}$/) && $id.matches(/^[a-z0-9]{6,24}$/) && !data.exists()",
                ".validate": "newData.hasChildren(['m', 'f', 'p', 't'])",
                "m": {
                  ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 160"
                },
                "f": {
                  ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 60"
                },
                "p": {
                  ".validate": "newData.isString() && newData.val().matches(/^[a-z0-9-]{2,40}$/)"
                },
                "t": {
                  ".validate": "newData.isNumber() && newData.val() == now"
                },
                "$autre": {
                  ".validate": false
                }
              }
            },
            "journal": {
              "$id": {
                ".write": "$site.matches(/^[a-z0-9-]{2,30}$/) && $jour.matches(/^20[0-9]{2}-[0-9]{2}-[0-9]{2}$/) && $id.matches(/^[a-z0-9-]{6,40}$/) && !data.exists()",
                ".validate": "newData.hasChildren(['a', 'p', 't'])",
                "a": {
                  ".validate": "newData.isString() && newData.val().matches(/^[a-z0-9-]{2,40}$/)"
                },
                "p": {
                  ".validate": "newData.isString() && newData.val().matches(/^[a-z0-9-]{2,40}$/)"
                },
                "t": {
                  ".validate": "newData.isNumber() && newData.val() == now"
                },
                "m": {
                  ".write": "data.parent().exists() && $id.matches(/^[a-z0-9-]{6,40}$/)",
                  ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 999 && (!data.exists() || newData.val() > data.val())"
                },
                "j": {
                  ".write": "data.parent().exists() && $id.matches(/^[a-z0-9-]{6,40}$/)",
                  ".validate": "newData.isString() && newData.val().length <= 3000 && newData.val().matches(/^[0-9]{1,2}([+][0-9]{1,2})?(,[0-9]{1,2}([+][0-9]{1,2})?)*$/) && (!data.exists() || newData.val().beginsWith(data.val() + ','))"
                },
                "d": {
                  ".write": "data.parent().exists() && $id.matches(/^[a-z0-9-]{6,40}$/)",
                  ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 86400 && (!data.exists() || newData.val() > data.val())"
                },
                "x": {
                  ".write": "data.parent().exists() && !data.exists() && $id.matches(/^[a-z0-9-]{6,40}$/)",
                  ".validate": "newData.isBoolean() && newData.val() == true"
                },
                "$autre": {
                  ".validate": false
                }
              }
            }
          }
        },
        "mois": {
          "$mois": {
            "visiteurs": {
              ".write": "$site.matches(/^[a-z0-9-]{2,30}$/) && $mois.matches(/^20[0-9]{2}-[0-9]{2}$/)",
              ".validate": "newData.isNumber() && newData.val() == (data.exists() ? data.val() : 0) + 1"
            }
          }
        },
        "total": {
          "vues": {
            ".write": "$site.matches(/^[a-z0-9-]{2,30}$/)",
            ".validate": "newData.isNumber() && newData.val() == (data.exists() ? data.val() : 0) + 1"
          },
          "visiteurs": {
            ".write": "$site.matches(/^[a-z0-9-]{2,30}$/)",
            ".validate": "newData.isNumber() && newData.val() == (data.exists() ? data.val() : 0) + 1"
          },
          "actions": {
            "$action": {
              "$page": {
                ".write": "$site.matches(/^[a-z0-9-]{2,30}$/) && $action.matches(/^[a-z0-9-]{2,40}$/) && $page.matches(/^[a-z0-9-]{2,40}$/)",
                ".validate": "newData.isNumber() && newData.val() == (data.exists() ? data.val() : 0) + 1"
              }
            }
          }
        },
        "noms": {
          "$type": {
            "$id": {
              ".write": "$site.matches(/^[a-z0-9-]{2,30}$/) && $type.matches(/^[a-z0-9-]{2,20}$/) && $id.matches(/^[a-z0-9-]{2,40}$/) && !data.exists()",
              ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 80"
            }
          }
        },
        "direct": {
          "$visite": {
            ".write": "$site.matches(/^[a-z0-9-]{2,30}$/) && $visite.matches(/^[a-z0-9]{6,24}$/)",
            ".validate": "newData.hasChildren(['p', 't'])",
            "p": {
              ".validate": "newData.isString() && newData.val().matches(/^[a-z0-9-]{2,40}$/)"
            },
            "t": {
              ".validate": "newData.isNumber() && newData.val() == now"
            },
            "$autre": {
              ".validate": false
            }
          }
        }
      }
    }
  }
}
